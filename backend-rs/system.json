{
  "cwd": "{system_dir}",
  "token": "token-change-me",
  "config_path": "config.json",
  "log_path": "data/okb-log.jsonl",
  "max_concurrent_tasks": 3,
  "database_url": "sqlite:///./data/okb_assist.db",
  "crossref_path": "data/markdowns/{id}_crossref.json",
  "info_path": "data/markdowns/{id}.json",
  "markdown_path": "data/markdowns/{id}.md",
  "markdown_asset_path": "data/pdfs/{id}/{id}.zip",
  "pdf_path": "data/pdfs/{id}/{id}.pdf",
  "chat_session_path": "data/chat_sessions/{id}.json",
  "uploads_folder": "data/_uploads",
  "static_dirs": [
    {
      "path": "/static",
      "dir": ".",
      "try_index": true,
      "index": "index.html",
      "list_dir": false,
      "auth": true,
      "cache_control": true
    }
  ],
  "mcp_token": "change-me",
  "trusted_subnets": [
    "192.168.1.0/24",
    "127.0.0.1/32"
  ],
  "mutool_path": "mutool",
  "ui_path": "../frontend/dist"
}